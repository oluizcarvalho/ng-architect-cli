name: CD

on:
  push:
    tags:
      - 'v*'

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Use Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20.x'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build:prod

      - name: Build Docker image
        run: docker build -t {{projectName}}:$\{{github.ref_name}} .

      - name: Push Docker image
        run: |
          echo "$\{{secrets.DOCKER_PASSWORD}}" | docker login -u "$\{{secrets.DOCKER_USERNAME}}" --password-stdin
          docker tag {{projectName}}:$\{{github.ref_name}} $\{{secrets.DOCKER_REGISTRY}}/{{projectName}}:$\{{github.ref_name}}
          docker push $\{{secrets.DOCKER_REGISTRY}}/{{projectName}}:$\{{github.ref_name}}
